# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth (Portal login) — Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL is the same value as SUPABASE_URL above.
# Leave both unset to keep the Portal public (no login required).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Analytics — leave unset to disable tracking entirely
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
