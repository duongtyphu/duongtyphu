# Supabase — dùng lại project VDAI Academy cũ (members/courses/orders/leads/
# referrals đã có dữ liệu thật). Project Settings → API trên Supabase Dashboard.
SUPABASE_URL=https://uosxpxolsvwcafxvnroy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth (Portal login) — Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL is the same value as SUPABASE_URL above.
# Leave both unset to keep the Portal public (no login required).
NEXT_PUBLIC_SUPABASE_URL=https://uosxpxolsvwcafxvnroy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVvc3hweG9sc3Z3Y2FmeHZucm95Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE1Mjk4MTgsImV4cCI6MjA5NzEwNTgxOH0.2fGXDEAYYFc5uxLnU1Ep4dvqkTmd0CLydLhDRpydVNE

# Google Analytics — leave unset to disable tracking entirely
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# SePay webhook — REQUIRED for checkout to work. Without this set, the
# webhook endpoint rejects all requests (fails closed) and orders will
# never auto-confirm. Set the same value in the SePay dashboard webhook
# config as: Authorization: Apikey <this value>
SEPAY_WEBHOOK_API_KEY=your-sepay-webhook-secret

# AI Provider Layer (src/ai/providers/) + Companion Studio (src/ai/agents/).
# Provider Wave 1 — 10 Provider, 4 Tier. All optional — missing any of
# these just makes that Provider report "unavailable" and ProviderManager
# falls back to MockProviderAdapter. Never commit real values.
# Core:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Recommended:
GROK_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=
# Specialized:
PERPLEXITY_API_KEY=
COHERE_API_KEY=
# Specialized (INF-01 — Additional AI Provider Integration):
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
