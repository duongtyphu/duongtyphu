{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/v-solo", "destination": "/v-solo/index.html" },
    { "source": "/v-solo/", "destination": "/v-solo/index.html" },
    { "source": "/v-scale", "destination": "/v-scale/index.html" },
    { "source": "/v-scale/", "destination": "/v-scale/index.html" }
  ],
  "redirects": [
    { "source": "/vdai-solo", "destination": "/v-solo", "permanent": true },
    { "source": "/vdai-solo/", "destination": "/v-solo", "permanent": true },
    { "source": "/vdai-scale", "destination": "/v-scale", "permanent": true },
    { "source": "/vdai-scale/", "destination": "/v-scale", "permanent": true }
  ]
}
