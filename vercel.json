{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/vdai-solo", "destination": "/vdai-solo/index.html" },
    { "source": "/vdai-solo/", "destination": "/vdai-solo/index.html" },
    { "source": "/vdai-scale", "destination": "/vdai-scale/index.html" },
    { "source": "/vdai-scale/", "destination": "/vdai-scale/index.html" }
  ],
  "redirects": [],
  "errorPages": {
    "404": "/404.html"
  }
}
